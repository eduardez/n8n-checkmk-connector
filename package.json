{
  "name": "n8n-nodes-checkmk-connector",
  "version": "0.2.0",
  "description": "Full-featured n8n connector for the Checkmk REST API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "checkmk",
    "monitoring"
  ],
  "license": "MIT",
  "homepage": "https://github.com/eduardez/n8n-checkmk-connector",
  "author": {
    "name": "eduardez"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardez/n8n-checkmk-connector.git"
  },
  "bugs": {
    "url": "https://github.com/eduardez/n8n-checkmk-connector/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier --write \"{credentials,nodes,test,scripts}/**/*.{ts,js,mjs,json}\"",
    "lint": "eslint credentials nodes package.json",
    "lintfix": "eslint credentials nodes package.json --fix",
    "generate": "node scripts/generate-catalog.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "test:integration": "npm run build && node --test test/integration/*.test.js",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CheckmkConnectorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CheckmkConnector/CheckmkConnector.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.4",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.120.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
